# Kestrel EHR - environment variable names only. Never commit real values.
#
# .env.local  -> used by `pnpm dev` (the kestrel-dev Supabase project).
#               Only the two NEXT_PUBLIC_ values belong here. The app runtime
#               refuses to start if SUPABASE_SECRET_KEY is present.
# .env.test   -> used by test, seed and migration scripts (kestrel-test project).

# --- App runtime (.env.local and .env.test) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Test / tooling only (.env.test) ---
# Project ref of the dedicated test project. Scripts refuse to run when the
# URL or database URL does not point at this ref.
KESTREL_TEST_PROJECT_REF=your-test-project-ref
# Server-side secret key. Used only by Node test and seed scripts.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Postgres connection string (session pooler or direct connection).
SUPABASE_DB_URL=postgresql://postgres.your-test-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres
# Password assigned to all seeded synthetic test identities. Use a long random value:
# the seed script refuses this placeholder and anything containing "change", "example" or "placeholder".
KESTREL_TEST_USER_PASSWORD=CHANGE_ME_BEFORE_SEEDING
# Personal access token, only needed for `pnpm db:types`.
SUPABASE_ACCESS_TOKEN=
