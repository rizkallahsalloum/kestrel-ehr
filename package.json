{
  "name": "kestrel-ehr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:db && pnpm test:int",
    "test:unit": "vitest run --project unit --project components",
    "test:db": "node scripts/assert-test-env.ts && vitest run --project db",
    "test:int": "node scripts/assert-test-env.ts && vitest run --project integration",
    "test:e2e": "node scripts/assert-test-env.ts && playwright test",
    "test:browser": "node scripts/clean-dev-cache.mjs && playwright test -c playwright.browser.config.ts",
    "db:push:test": "node scripts/db.ts push",
    "db:push:test:dry": "node scripts/db.ts push --dry-run",
    "db:reset:test": "node scripts/db.ts reset",
    "db:seed:test": "node scripts/seed.ts",
    "db:types": "node scripts/db.ts types",
    "tokens:build": "node scripts/build-tokens.mjs",
    "check:bundle": "node scripts/check-client-bundle.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "pg": "^8.23.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.32.1"
}
