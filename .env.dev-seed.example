# Kestrel EHR - Dev seed settings, names and placeholders only. Never commit real values.
# Copy to .env.dev-seed (git-ignored) for `pnpm db:seed:dev:dry` and `pnpm db:seed:dev`.
# The seed refuses to run unless every URL below points at KESTREL_DEV_PROJECT_REF,
# that ref is the Kestrel-Dev project, and it differs from KESTREL_TEST_PROJECT_REF.

# Kestrel-Dev project ref (the one in .env.local's URL).
KESTREL_DEV_PROJECT_REF=your-dev-project-ref
# Kestrel-Test project ref, so the seed can refuse to run if the two are ever the same.
KESTREL_TEST_PROJECT_REF=your-test-project-ref

NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Used only to create the missing synthetic Auth users (Auth admin API).
SUPABASE_SECRET_KEY=sb_secret_xxx
# Postgres connection string for Kestrel-Dev. The dry run opens a read-only transaction.
SUPABASE_DB_URL=postgresql://postgres.your-dev-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Password for synthetic seed accounts the seed creates (existing accounts are never changed).
# Use a long random value: the seed refuses this placeholder and anything containing
# "change", "example" or "placeholder".
KESTREL_DEV_SEED_PASSWORD=CHANGE_ME_BEFORE_SEEDING
